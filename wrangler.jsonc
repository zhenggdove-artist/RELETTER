{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reletter-garden",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{"name":"RELETTER_GARDEN","class_name":"ReletterGarden"}]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["ReletterGarden"]}]
}
